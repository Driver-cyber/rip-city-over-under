{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ripcity-over-under",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "ripcity", "database_id": "REPLACE_AFTER_D1_CREATE", "migrations_dir": "migrations" }
  ],
  // Every 15 minutes: refresh the schedule, post lines for games within 30 hours, grade finished games.
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [{ "pattern": "ripcity.chadstewartcpa.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
